# Cairn Configuration
# Copy to .env and update values

# Authentication — changing ADMIN_PASSWORD on the next container start
# rotates the stored hash and invalidates all existing browser sessions.
ADMIN_USERNAME=username
ADMIN_PASSWORD=change-this-to-something-secure

# Optional — enables the AI Copilot tab
ANTHROPIC_API_KEY=

# Optional — daily SQLite backup location and rotation window
BACKUP_DIR=/app/data/backups
BACKUP_RETAIN_DAYS=14
